# Model selection (optional if set via `shandu configure`)
SHANDU_MODEL=deepseek/deepseek-flash

# A model for one role: PLANNER, RESEARCHER, EXTRACTOR, SYNTHESIZER, WRITER, AUDITOR.
# Extraction makes most of the calls, so a cheaper extractor cuts cost the most.
# SHANDU_MODEL_EXTRACTOR=

# Compatibility fallback model env var
OPENAI_MODEL_NAME=

# Provider key mapping used by Shandu runtime
# Example values: DEEPSEEK_API_KEY, OPENROUTER_API_KEY, ANTHROPIC_API_KEY, ANYSUPPORTED_API_KEY
SHANDU_API_KEY_ENV=DEEPSEEK_API_KEY

# Provider API key value used when SHANDU_API_KEY_ENV is set
# SHANDU_API_KEY=your_provider_api_key_here

# Optional direct provider env vars (LiteLLM style). Use what matches your model provider.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generation controls
SHANDU_TEMPERATURE=0.2
SHANDU_MAX_TOKENS=32768

# Runtime storage (default: ~/.shandu/storage)
# SHANDU_STORAGE_DIR=

# Optional HTTP proxy for scraping
SHANDU_PROXY=

# Web search: ddgs (default), or tavily, brave, exa, or searxng with its variable.
# SHANDU_SEARCH_BACKEND=ddgs
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
# SEARXNG_URL=

# Optional keys that raise the paper-search rate limits. Without a key,
# OpenAlex allows about 100 searches a day.
# OPENALEX_API_KEY=
# NCBI_API_KEY=
